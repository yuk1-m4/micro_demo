#!/bin/sh
# プッシュするコミットのメッセージに、Claude へのリンクがあれば拒否する（ADR 0007）。
# cherry-pick や --no-verify など、commit-msg を通らなかったコミットもここで止める。
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # ブランチの削除
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # 新しいブランチ：まだリモートにないコミットだけ
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  bad=$(git log --format='%h %s' -E --grep='claude\.ai/' --grep='claude\.com/' --grep='^Claude-Session:' $range)
  if [ -n "$bad" ]; then
    echo "pre-push: 次のコミットに Claude へのリンクがあります。メッセージを直してからプッシュしてください。" >&2
    echo "$bad" >&2
    status=1
  fi
done
exit $status
